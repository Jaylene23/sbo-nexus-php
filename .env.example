SBO_DB_HOST=localhost
SBO_DB_USER=your_database_user
SBO_DB_PASS=your_database_password
SBO_DB_NAME=sbo_nexus

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/sbo-nexus-php/auth/google_callback.php

# Email notifications (students are emailed when the Adviser approves an event)
# Leave blank to turn email off. For Gmail use smtp.gmail.com, port 587, and an App Password.
SBO_SMTP_HOST=smtp.gmail.com
SBO_SMTP_PORT=587
SBO_SMTP_SECURE=tls
SBO_SMTP_USER=your-sender@gmail.com
SBO_SMTP_PASS=your-app-password
SBO_MAIL_FROM=your-sender@gmail.com
SBO_MAIL_FROM_NAME=SBO Nexus
# Public address of the system, used for links inside emails (no trailing slash)
SBO_BASE_URL=http://localhost/sbo-nexus-php

# Secret for the daily reminder job when it is called by URL (leave blank to allow command line only).
# Use a long random value, for example from https://www.random.org/strings/
SBO_CRON_KEY=

# Set to 1 only when the site is behind Cloudflare or another proxy, so the Activity Log records visitors' real IP addresses.
SBO_TRUST_PROXY=0
